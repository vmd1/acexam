# Copy to .env in this directory (backend/training/) before running agent.py.
# This agent is a host-native process, separate from the Docker Compose
# stack - it reaches Postgres and Redis via the ports docker-compose.yml
# already publishes to the host (5432 / 6379), rather than the
# "postgres"/"redis" service names the containerized backend uses. There is
# no HTTP between this agent and the backend at all - both just talk to
# these same shared Postgres/Redis instances (Redis as a work queue for
# marking requests - see MLX_QUEUE_KEY in agent.py/ai_pipeline.py).

DATABASE_URL=postgresql://acexam:acexam@localhost:5432/acexam
REDIS_URL=redis://localhost:6379

# How often the training-job poller checks for queued jobs, and how often
# the janitor sweep (stop no-longer-live/crashed/idle servers) runs. Model
# loading itself is on-demand (triggered by a marking job arriving on the
# Redis queue), not on a poll cycle.
TRAINING_POLL_INTERVAL=5
SWEEP_INTERVAL=15

# Host port range the agent allocates mlx_lm.server processes from. Distinct
# from backend(8000)/frontend(5173)/postgres(5432)/redis(6379)/traefik(80).
MLX_SERVER_PORT_RANGE_START=8100
MLX_SERVER_PORT_RANGE_END=8199

# Dynamic loading: at most this many models resident (loaded into memory) at
# once - given a single Mac's unified memory, this is very unlikely to be
# "however many spec codes are live". Loading is on demand, evicting the
# least-recently-used resident model to make room for a newly requested one.
# Loads for different spec codes happen in parallel (not serialized), so
# this many marking requests for different cold spec codes can be loading
# at the same time.
MAX_CONCURRENT_SERVERS=8

# A resident model idle longer than this (seconds) is proactively evicted by
# the sweep loop, freeing memory even before something else needs the slot.
IDLE_EVICT_SECONDS=600

# How long to wait for a freshly started mlx_lm.server to answer /v1/models
# before giving up on it (this is the ceiling on a "cold" load's latency - a
# resident/warm model answers in milliseconds), and how long to back off
# before retrying a spec code whose server failed to come up healthy.
MLX_HEALTH_CHECK_TIMEOUT=45
MLX_UNHEALTHY_RETRY_BACKOFF=60

# Auto-training (§6.5): once a spec code has this many accepted
# training_examples (populated automatically by ingestion, no separate
# step) it gets queued for its first training run with no admin click
# needed. An already-trained spec code gets queued again once it has
# accumulated this many *new* accepted examples since its last run, or
# that run is this many days old - whichever comes first. Set
# AUTO_TRAIN_ENABLED=false to require the admin UI's "Request training"
# button for everything instead.
AUTO_TRAIN_ENABLED=true
AUTO_TRAIN_MIN_EXAMPLES=50
AUTO_RETRAIN_NEW_EXAMPLES=200
AUTO_RETRAIN_MAX_AGE_DAYS=30
AUTO_TRAIN_SCAN_INTERVAL=600
