DATABASE_URL=postgresql://acexam:acexam@localhost:5432/acexam
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_dev_secret

# Dev-only seeded admin account (used by seed.py). Change before any
# non-local deployment.
SEED_ADMIN_EMAIL=admin@acexam.dev
SEED_ADMIN_PASSWORD=AdminDev123!

# Optional: enables real AI calls (ingestion vision descriptions, DSL compilation,
# synthetic answer generation, misconception scanning, AI marking). Falls back to
# a deterministic local stub when unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional OpenAI-compatible fallback (used only if GEMINI_API_KEY is unset)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
